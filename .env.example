# ── ТЕХНОЛАБ · переменные окружения (скопируйте в .env и заполните) ──────────

# База данных. Диалект выбирается по префиксу:
#   file:./dev.db  → SQLite (better-sqlite3), схема создаётся сама
#   postgresql://  → PostgreSQL (pg), схема из db-setup.sql
DATABASE_URL="file:./dev.db"
# Прод (Neon/Supabase/RDS):
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Размер пула PG-соединений на инстанс:
PGPOOL_MAX=5

# Автонаполнение каталога стартовыми товарами при первом запросе.
# Включено по умолчанию: сид идемпотентный и достраивает недостающее (бренды,
# варианты, характеристики) у товаров, созданных прошлым деплоем.
# Данные — src/lib/catalog-seed.ts, схема создаётся автоматически.
# Выключить, когда товары ведутся только через /admin: AUTO_SEED=0
# AUTO_SEED=0

# ── Хранилище фото товаров ──────────────────────────────────────────────────
# Без S3-настроек локально файлы пишутся в public/uploads/ (в .gitignore).
# На Vercel локальная запись недоступна: без S3 загрузка вернёт 501 — это ожидаемо.
# Подходит S3, Cloudflare R2, MinIO и совместимые.
S3_BUCKET=
S3_REGION=auto
# Для R2/MinIO укажите endpoint; для AWS S3 оставьте пустым:
S3_ENDPOINT=
# Публичная база для ссылок на фото (CDN-домен или https://bucket.s3.region.amazonaws.com):
S3_PUBLIC_BASE_URL=
# Если не заданы — берётся стандартная цепочка креденшелов AWS (IAM-роль на Vercel).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Telegram-бот (BotFather → /newbot). Нужен для проверки initData и отправки заявок в группу
BOT_TOKEN=

# ID группы/канала, куда приходят заявки (узнать: добавьте @userinfobot или бота в группу)
GROUP_CHAT_ID=

# Telegram ID владельца (единственный, кто видит /admin). Узнать: напишите боту /start или @userinfobot
OWNER_TELEGRAM_ID=

# ── Админ-бот ───────────────────────────────────────────────────────────────
# Числовые Telegram ID админов через запятую — надёжнее username (его можно сменить).
# Пусто = доступ к панели бота закрыт полностью. ID владельца из OWNER_TELEGRAM_ID
# тоже считается админом, так что дублировать не обязательно.
# Можно прислать боту /id — он ответит вашим ID.
ADMIN_TELEGRAM_IDS=
# Запасной способ: username через запятую, без @.
ADMIN_TELEGRAM_USERNAMES=

# Секрет вебхука: Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token,
# поэтому посторонние не могут слать боту поддельные апдейты.
# Строка 1–256 символов: A-Z, a-z, 0-9, _ или -. Без неё вебхук отвечает 503.
BOT_WEBHOOK_SECRET=
# Одноразовый токен для /api/bot/setup?token=… — ставит вебхук и команды меню.
BOT_SETUP_TOKEN=

# Публичный URL мини-приложения (после деплоя — адрес сайта)
WEBAPP_URL=http://localhost:3000

# Dev-режим: разрешить вход без initData. Работает только при NODE_ENV != production
# и только на localhost / *.e2b.app / хостах из DEV_NO_AUTH_HOSTS. На проде не включать.
ALLOW_DEV_NO_AUTH=1

# Дополнительные хосты для dev-режима (через запятую), например: my-dev-tunnel.example.com
DEV_NO_AUTH_HOSTS=
