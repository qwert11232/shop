# ── ТЕХНОЛАБ · переменные окружения (скопируйте в .env и заполните) ──────────

# База данных. Сейчас код работает только с SQLite-файлом:
DATABASE_URL="file:./dev.db"
# Прод-PostgreSQL ещё НЕ реализован в src/lib/db.ts (слой данных на better-sqlite3).
# Схема для managed-Postgres лежит в db-setup.sql — подключается после появления PG-адаптера:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Telegram-бот (BotFather → /newbot). Нужен для проверки initData и отправки заявок в группу
BOT_TOKEN=

# ID группы/канала, куда приходят заявки (узнать: добавьте @userinfobot или бота в группу)
GROUP_CHAT_ID=

# Telegram ID владельца (единственный, кто видит /admin). Узнать: напишите боту /start или @userinfobot
OWNER_TELEGRAM_ID=

# Публичный URL мини-приложения (после деплоя — адрес сайта)
WEBAPP_URL=http://localhost:3000

# Dev-режим: разрешить вход без initData. Работает только при NODE_ENV != production
# и только на localhost / *.e2b.app / хостах из DEV_NO_AUTH_HOSTS. На проде не включать.
ALLOW_DEV_NO_AUTH=1

# Дополнительные хосты для dev-режима (через запятую), например: my-dev-tunnel.example.com
DEV_NO_AUTH_HOSTS=
