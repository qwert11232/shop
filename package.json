{
  "name": "tekhnolab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts",
    "check:pg": "tsx scripts/check-postgres.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "check": "npm run lint && npm run typecheck && npm run check:storage && npm run check:pg && npm run check:bot && npm run check:shop",
    "check:bot": "tsx scripts/check-bot.ts",
    "bot:setup": "echo 'Откройте https://<домен>/api/bot/setup?token=<BOT_SETUP_TOKEN>'",
    "check:shop": "tsx scripts/check-shop.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@fontsource/manrope": "^5.2.5",
    "@fontsource/unbounded": "^5.2.5",
    "better-sqlite3": "^13.0.3",
    "next": "^15.3.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
